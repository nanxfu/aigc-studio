{
  "name": "aigc-studio",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "AIGC Studio — standalone desktop AIGC workbench (image / video / 3D) backed by Kaggle / Colab / private GPU workers",
  "license": "MIT",
  "author": "nanxfu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanxfu/aigc-studio.git"
  },
  "homepage": "https://github.com/nanxfu/aigc-studio#readme",
  "bugs": {
    "url": "https://github.com/nanxfu/aigc-studio/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env server/standalone.js",
    "build:web": "vite build",
    "build:test": "node tools/build-web-test-bundle.mjs --test",
    "build": "vite build && node tools/build-web-test-bundle.mjs --test",
    "start": "node server/standalone.js",
    "pack": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder",
    "preview": "node tools/preview.mjs",
    "preview:shot": "node tools/preview.mjs --shot",
    "test": "node test/run-all.mjs",
    "test:contract": "node test/run-all.mjs --group contract",
    "test:client": "node test/run-all.mjs --group client",
    "test:host": "node test/run-all.mjs --group host",
    "test:local-gpu": "node test/local-gpu-runtime.mjs",
    "test:local-gpu:live": "node test/local-gpu-live.mjs",
    "test:local-gpu:host": "node test/local-gpu-host.mjs",
    "test:worker": "python test/worker/run.py",
    "test:packaged": "node test/smoke-packaged.mjs",
    "test:installer": "node test/smoke-installer.mjs",
    "models:build": "node tools/build-assets.mjs",
    "models:check": "node tools/build-assets.mjs --check",
    "icons:build": "python tools/build-icons.py",
    "icons:check": "python tools/build-icons.py --check",
    "worker:check": "python tools/check-worker-image.py",
    "kaggle:probe": "node tools/probe-kaggle.mjs",
    "contract:gen": "node tools/gen-contract-json.mjs",
    "contract:check": "node tools/gen-contract-json.mjs --check",
    "release:verify": "node tools/verify-release.mjs",
    "release:dry": "npm run build:web && electron-builder --win nsis portable --publish never && node tools/verify-release.mjs",
    "update:mock": "node tools/mock-update-feed.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:config": "node mcp/server.mjs --print-config"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2",
    "onnxruntime-web": "1.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "vite": "^7.3.6"
  }
}
