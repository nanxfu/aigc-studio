---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkshopLab from '../components/WorkshopLab.astro';
import { DOWNLOAD, SITE, WORKSHOP_TOOLS } from '../data/site';

const title = '资产工坊：去背、矢量、像素对齐与 PBR — AIGC Studio';
const description = '内置资产工坊，覆盖抹除背景、转 SVG 矢量、无缝平铺、像素对齐、序列帧切片与 PBR 四通道材质拆解。';

const planeTools = WORKSHOP_TOOLS.filter((t) => t.group === '平面与提取');
const gameTools = WORKSHOP_TOOLS.filter((t) => t.group === '游戏与 3D');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: `${SITE.domain}/workshop`,
};
---

<BaseLayout title={title} description={description} path="/workshop" jsonLd={jsonLd}>
  <section class="section section-first" style="padding-bottom: 0;">
    <div class="container">
      <div class="section-head" style="margin-bottom: 0;">
        <div>
          <div class="section-idx">ASSET WORKSHOP</div>
          <h1 class="section-title">资产工坊</h1>
        </div>
        <p class="section-sub">
          预览不写盘，确认应用后按复合资产包存到本地，与原图保持完整版本树关联。
        </p>
      </div>
    </div>
  </section>

  <WorkshopLab showLink={false} hideHeader={true} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-idx">SPECS / 平面与游戏</div>
          <h2 class="section-title">六项工具明细</h2>
        </div>
      </div>

      <h3 class="mono" style="font-size:12px; color:var(--ink-3); margin:0 0 16px;">01 / 平面与提取</h3>
      <div class="cards-grid" style="margin-bottom: 44px;">
        {planeTools.map((tool) => (
          <article class="specimen-card">
            <div class="specimen-body">
              <div class="specimen-top">
                <h3>{tool.name}</h3>
                <span class={tool.local ? 'badge badge-ok' : 'badge'}>{tool.runtime}</span>
              </div>
              <p>{tool.desc}</p>
              <div class="specimen-foot">
                <span>{tool.engine}</span>
                <span>{tool.output}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <h3 class="mono" style="font-size:12px; color:var(--ink-3); margin:0 0 16px;">02 / 游戏与 3D</h3>
      <div class="cards-grid" style="margin-bottom: 40px;">
        {gameTools.map((tool) => (
          <article class="specimen-card">
            <div class="specimen-body">
              <div class="specimen-top">
                <h3>{tool.name}</h3>
                <span class={tool.local ? 'badge badge-ok' : 'badge'}>{tool.runtime}</span>
              </div>
              <p>{tool.desc}</p>
              <div class="specimen-foot">
                <span>{tool.engine}</span>
                <span>{tool.output}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="callout">
        <strong>复合资产包与延伸指南：</strong>
        PBR 四通道、序列帧图集与 SVG 均绑定在来源作品的同一条版本树上，不会散落成无名文件。详细操作可阅读
        <a href="/guides/ai-pixel-art-sprite" class="link-inline">像素画对齐与序列帧导出指南</a> 与
        <a href="/guides/ai-image-to-svg" class="link-inline">本机转 SVG 矢量指南</a>。
      </div>
    </div>
  </section>

  <section class="p95-curtain">
    <div class="p95-watermark" aria-hidden="true">AIGC STUDIO</div>
    <div class="container p95-curtain-inner">
      <h2>开源免费，安装即用。</h2>
      <p>下载桌面客户端，四项本机零显存工坊工具全部内置。</p>
      <div class="cta-actions" style="justify-content: center;">
        <a href={DOWNLOAD.winUrl} class="btn btn-primary btn-lg" data-os-download="hero" data-umami-event-slot="curtain" target="_blank" rel="noopener noreferrer">下载 Windows 版 v{SITE.version}</a>
        <a href="/models" class="btn btn-lg">模型实测</a>
      </div>
    </div>
  </section>
</BaseLayout>
