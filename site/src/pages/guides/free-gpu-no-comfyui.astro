---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideRelated from '../../components/GuideRelated.astro';
import { COMPARISON_ROWS, SITE } from '../../data/site';

const title = '没有独立显卡，如何免配 ComfyUI 跑开源生图模型 — AIGC Studio';
const description = '轻薄本或 Mac 无需独立显卡与 Python 环境，通过 Kaggle 免费双卡或 Colab 运行开源模型，成图自动存回本地。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: `${SITE.domain}/guides/free-gpu-no-comfyui`,
};
---

<BaseLayout title={title} description={description} path="/guides/free-gpu-no-comfyui" jsonLd={jsonLd}>
  <article class="section section-first">
    <div class="container article-wrap">
      <div class="section-idx">GUIDE / ARCHITECTURE</div>
      <h1>无独立显卡运行开源生图模型指南</h1>
      <p>
        过去想用开源生图模型，通常只有两种选择：要么买 16GB 以上显存的显卡，在本机搭建 Python、CUDA 与节点连线环境；要么给在线网站按月续费，把作品留在平台云端。
      </p>

      <div class="callout">
        <strong>界面留本地，推理放云端。</strong>
        本机只运行轻量桌面端（不吃显存），生图请求通过临时加密隧道发往云端显卡会话，出图后原图与参数自动存回你自己的本地硬盘。
      </div>

      <h2>1. 云端算力来源与免费额度</h2>
      <p>AIGC Studio 内置四类可随时切换的算力后端：</p>
      <ul>
        <li><strong>Kaggle 免费显卡（默认）</strong>：每周 30 小时免费双 T4，合计 30GB 显存，能运行主力模型。</li>
        <li><strong>Google Colab</strong>：支持免费 T4 或 Pro 的 L4 / A100，适合大显存模型。</li>
        <li><strong>私有远端服务器</strong>：支持部署到 AutoDL、RunPod 或公司内网 GPU，长驻免冷启。</li>
        <li><strong>商业云 API</strong>：需要即开即用或同时生视频时可以接入。</li>
      </ul>

      <h2>2. 无节点界面的参数控制</h2>
      <p>
        日常创作高频用到的操作相当集中：写提示词、定画幅、挂参考图，加上局部重绘与高清放大，最后是出图后的去背与矢量转换。
      </p>
      <p>
        面板会按所选模型只显示真正生效的参数。不确定英文提示词写法时，可在提案助手中用中文沟通，先确认画幅与描述再出图。
      </p>

      <h2>3. 方案对照</h2>
      <div class="table-wrap" style="margin: 22px 0 32px;">
        <table class="compare-table">
          <thead>
            <tr>
              <th>维度</th>
              <th class="is-highlight">AIGC Studio</th>
              <th>本地 ComfyUI</th>
              <th>在线生图网站</th>
            </tr>
          </thead>
          <tbody>
            {COMPARISON_ROWS.map((row) => (
              <tr>
                <td><strong>{row.dim}</strong></td>
                <td class="is-highlight">{row.studio}</td>
                <td>{row.comfy}</td>
                <td>{row.web}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>4. 适用边界</h2>
      <p>
        如果本机已有 24GB 以上的高端显卡，且需要训练 LoRA、叠加多层 ControlNet 或编排复杂的科研工作流，本地 ComfyUI 依然是上限最高的工具。
      </p>
      <p>
        如果你的目标是<strong>用普通电脑零配置跑通主流开源模型、把原图留在本地，并就地完成去背、矢量或游戏贴图加工</strong>，AIGC Studio 是更短的路径。
      </p>
    </div>
  </article>

  <GuideRelated currentSlug="free-gpu-no-comfyui" />
</BaseLayout>
