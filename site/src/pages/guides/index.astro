---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DOWNLOAD, GUIDES, SITE } from '../../data/site';

const title = '使用指南与选型参考 — AIGC Studio';
const description = '涵盖无独立显卡运行开源模型、AIGC Studio 与 ComfyUI 选型对照、像素画对齐与序列帧导出、本地转 SVG 矢量及 MCP 接入 Claude / Cursor。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `${SITE.domain}/guides`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: GUIDES.length,
    itemListElement: GUIDES.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: `${SITE.domain}${g.path}`,
    })),
  },
};
---

<BaseLayout title={title} description={description} path="/guides" jsonLd={jsonLd}>
  <section class="section section-first">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-idx">GUIDES / FIELD NOTES</div>
          <h1 class="section-title">使用指南与选型</h1>
        </div>
        <p class="section-sub">
          按实际创作与开发场景整理的操作说明、对比对照与适用边界，数据均来自实测环境与项目当前代码。
        </p>
      </div>

      <div class="guide-grid">
        {GUIDES.map((g, idx) => (
          <a href={g.path} class="guide-card">
            <div class="guide-card-top">
              <span>0{idx + 1} / {g.tag}</span>
              <span>{g.readTime}</span>
            </div>
            <h2>{g.title}</h2>
            <p>{g.description}</p>
            <div class="guide-card-foot">
              <span>{g.audience}</span>
              <span>查看详情 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="p95-curtain">
    <div class="p95-watermark" aria-hidden="true">AIGC STUDIO</div>
    <div class="container p95-curtain-inner">
      <h2>原图留在本地，算力按需调用。</h2>
      <p>MIT 协议 · Windows x64 安装包（macOS / Linux 支持源码运行）</p>
      <div class="cta-actions" style="justify-content: center;">
        <a href={DOWNLOAD.winUrl} class="btn btn-primary btn-lg" data-os-download="hero" data-umami-event-slot="curtain" target="_blank" rel="noopener noreferrer">
          下载 Windows 版 v{SITE.version}
        </a>
        <a href="/workshop" class="btn btn-lg">资产工坊</a>
      </div>
    </div>
  </section>
</BaseLayout>
