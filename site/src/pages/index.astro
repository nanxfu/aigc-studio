---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainStory from '../components/DomainStory.astro';
import BenchCompare from '../components/BenchCompare.astro';
import WorkshopLab from '../components/WorkshopLab.astro';
import { COMPARISON_ROWS, FAQS, MODELS, SITE, WORKSPACE_VIEWS } from '../data/site';

const filmFrames = [
  ...MODELS.map((m, idx) => ({
    src: m.showcase.image,
    title: m.showcase.title,
    tag: `0${idx + 1} · ${m.label}`,
    sec: m.showcase.measuredSec,
  })),
  { src: '/assets/bench/flux2-klein-9b/05-material-refraction.webp', title: '翡翠香水瓶折射', tag: '08 · FLUX.2 Klein 9B', sec: '9B' },
  { src: '/assets/bench/qwen-image-2.1/01-typography-poster.webp', title: 'BREW 2026 海报', tag: '09 · Qwen-Image 2.1', sec: '8 步' },
  { src: '/assets/bench/z-image-turbo/06-chinese-aesthetics.webp', title: '江南晨雾水乡', tag: '10 · Z-Image Turbo', sec: '9 步' },
];

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
    sameAs: [SITE.github],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.domain,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Windows, macOS, Linux',
    softwareVersion: SITE.version,
    license: 'https://opensource.org/licenses/MIT',
    description: SITE.description,
    url: SITE.domain,
    downloadUrl: SITE.releases,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} path="/" ogImage="/assets/studio-light.png" jsonLd={homeJsonLd}>
  <!-- Full-Viewport Cinema Projector Hero -->
  <section class="p95-hero" id="lighttable">
    <div class="p95-hero-bg">
      <img
        id="p95-bg"
        src={MODELS[1].showcase.image}
        alt={MODELS[1].showcase.title}
        style={`object-position: ${MODELS[1].showcase.pos || '50% 50%'};`}
      />
    </div>
    <div class="p95-hero-vignette" aria-hidden="true"></div>

    <div class="container p95-hero-inner">
      <div>
        <div class="p95-kicker">
          <span class="lamp-dot" aria-hidden="true"></span>
          <span>MIT OPEN SOURCE · WINDOWS / MACOS / LINUX</span>
        </div>
        <h1 class="p95-h1">免显卡，免配置，<br />运行旗舰开源模型。</h1>
        <p class="p95-lead">
          本地桌面工作台搭配云端弹性算力。默认接入 Kaggle 每周 30 小时免费双卡，亦支持 Colab、私有服务器与商业 API；原图、参数与衍生素材全部保存在本地硬盘。
        </p>
        <div class="p95-hero-actions">
          <a href={SITE.releases} class="btn btn-lg p95-btn-white" target="_blank" rel="noopener noreferrer">
            下载客户端 v{SITE.version}
          </a>
          <a href="/models" class="btn btn-lg p95-btn-glass">模型实测</a>
          <button type="button" class="btn btn-lg p95-btn-glass" id="p95-zoom-hero">检视当前原片</button>
        </div>
      </div>

      <div class="p95-rail">
        <div class="p95-rail-num" id="p95-num">02</div>
        <div class="p95-rail-title" id="p95-title">{MODELS[1].showcase.title}</div>
        <div id="p95-meta">{MODELS[1].label} · {MODELS[1].showcase.measuredSec}</div>
        <div id="p95-lic">{MODELS[1].license}</div>
      </div>
    </div>

    <div class="p95-dock">
      <div class="container" style="padding: 0;">
        <div class="p95-dock-grid" role="tablist" aria-label="切换首屏实测原片">
          {MODELS.map((m, idx) => (
            <button type="button" role="tab" class={idx === 1 ? 'p95-slide-btn is-active' : 'p95-slide-btn'} data-slide-idx={idx}>
              <img src={m.showcase.image} alt="" style={`object-position:${m.showcase.pos || '50% 50%'};`} />
              <div style="min-width:0;">
                <div class="p95-slide-name">{m.showcase.title}</div>
                <div class="p95-slide-sec">{m.showcase.measuredSec}</div>
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Continuous 35mm Filmstrip Marquee -->
  <section class="p95-filmstrip-band" aria-label="真机实测样片胶片带">
    <div class="p95-sprockets" aria-hidden="true"></div>
    <div class="p95-track">
      {[...filmFrames, ...filmFrames].map((f) => (
        <figure class="p95-frame" style="margin:0;" data-lightbox data-caption={`${f.title} — ${f.tag}`}>
          <img src={f.src} alt={f.title} loading="lazy" />
          <figcaption class="p95-frame-cap">
            <span>{f.tag}</span>
            <span>{f.sec}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="p95-sprockets" aria-hidden="true"></div>
  </section>

  <!-- 01. Stepped Architecture -->
  <section class="section" id="workflow">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <div class="section-idx">01 / ARCHITECTURE</div>
          <h2 class="section-title">运行方式</h2>
        </div>
        <p class="section-sub">计算交由云端临时会话完成，画布操作、版本记录与导出文件留在本机目录。</p>
      </div>

      <div class="step-stairs" data-reveal>
        <article class="stair-card">
          <span class="stair-ghost" aria-hidden="true">01</span>
          <div class="stair-tag">COMPUTE</div>
          <h3>按需挂载云端算力</h3>
          <p>绑定 Kaggle 或 Google Colab 即可启动远端推理，亦支持私有 GPU 与商业 API。活跃会话防误关，空闲自动休眠。</p>
        </article>
        <article class="stair-card">
          <span class="stair-ghost" aria-hidden="true">02</span>
          <div class="stair-tag">COMPOSE</div>
          <h3>表单精调与提案对话</h3>
          <p>参数面板随当前模型自动收拢为生效项；也可直接用中文与提案助手确定画幅、模型与提示词后再提交生成。</p>
        </article>
        <article class="stair-card">
          <span class="stair-ghost" aria-hidden="true">03</span>
          <div class="stair-tag">LOCAL FILES</div>
          <h3>本地版本树与工坊交付</h3>
          <p>原图经加密隧道直存本地工作区。局部重绘、放大与扩图自动归为版本树，衍生素材在工坊内就地导出。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Full-Viewport Sticky Curtain Narrative: Vertical Domains -->
  <DomainStory />

  <!-- 02. Same-Prompt 7-Model Benchmark with 2.4x Optical Loupe -->
  <BenchCompare />

  <!-- 03. Sticky Scroll Narrative (滚动粘性叙事 — Desktop Workbench) -->
  <section class="story-interlude" id="desktop">
    <div class="container">
      <div class="story-header">
        <div>
          <div class="section-idx" style="color:var(--pi-ink-2);">03 / WORKBENCH</div>
          <h2>桌面工作台</h2>
        </div>
        <p>调参、提案对话、模型切换与本地作品库集成于独立客户端。随页面滚动依次浏览四个核心视图。</p>
      </div>

      <div class="story-grid" id="story-root">
        <div class="story-chapters">
          <div class="story-rail" aria-hidden="true">
            <div class="story-rail-fill" id="story-rail-fill"></div>
          </div>

          {WORKSPACE_VIEWS.map((v, i) => (
            <article class={i === 0 ? 'story-step is-active' : 'story-step'} data-story-step={i}>
              <div class="story-step-idx">0{i + 1}</div>
              <h3>{v.label}</h3>
              <p>{v.summary}</p>
            </article>
          ))}
        </div>

        <div class="story-sticky">
          <div class="story-stage">
            <div class="story-stage-bar">
              <span id="story-label">{WORKSPACE_VIEWS[0].label}</span>
              <span id="story-counter">01 / 04</span>
            </div>
            <div class="story-viewport">
              {WORKSPACE_VIEWS.map((v, i) => (
                <div class={i === 0 ? 'story-slide is-active' : 'story-slide'} data-story-slide={i}>
                  <img src={v.image} alt={v.alt} data-lightbox data-caption={v.label} loading="lazy" />
                </div>
              ))}
            </div>
            <div class="story-progress-bar" aria-hidden="true">
              <div class="story-progress-fill" id="story-progress-fill"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04. Asset Workshop Lab -->
  <WorkshopLab showLink={true} />

  <!-- 05. Architectural Comparison Cards -->
  <section class="section" id="compare">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <div class="section-idx">05 / COMPARISON</div>
          <h2 class="section-title">方案对照</h2>
        </div>
        <p class="section-sub">与本地 ComfyUI、在线生图平台在硬件门槛、成本、数据归属与后处理上的差异。</p>
      </div>

      <div class="p95-comp-grid" data-reveal>
        <div class="p95-comp-col is-hero">
          <div class="p95-comp-head">
            <div class="section-idx" style="color:var(--safelight);">LOCAL WORKBENCH + REMOTE GPU</div>
            <h3>AIGC Studio</h3>
          </div>
          <div class="p95-comp-list">
            {COMPARISON_ROWS.map((r) => (
              <div class="p95-comp-row">
                <span class="p95-comp-dim">{r.dim}</span>
                <span class="p95-comp-val">{r.studio}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="p95-comp-col">
          <div class="p95-comp-head">
            <div class="section-idx">LOCAL NODE GRAPH</div>
            <h3>本地 ComfyUI</h3>
          </div>
          <div class="p95-comp-list">
            {COMPARISON_ROWS.map((r) => (
              <div class="p95-comp-row">
                <span class="p95-comp-dim">{r.dim}</span>
                <span class="p95-comp-val">{r.comfy}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="p95-comp-col">
          <div class="p95-comp-head">
            <div class="section-idx">CLOUD SUBSCRIPTION</div>
            <h3>在线生图网站</h3>
          </div>
          <div class="p95-comp-list">
            {COMPARISON_ROWS.map((r) => (
              <div class="p95-comp-row">
                <span class="p95-comp-dim">{r.dim}</span>
                <span class="p95-comp-val">{r.web}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. Asymmetric Editorial FAQ -->
  <section class="section" id="faq">
    <div class="container">
      <div class="p95-faq-grid" data-reveal>
        <div class="p95-faq-sticky">
          <div class="section-idx">06 / FAQ</div>
          <h2 class="section-title">常见问题</h2>
          <div class="p95-faq-count" id="p95-faq-num">01 / 07</div>
        </div>

        <div class="faq-list">
          {FAQS.map((item, idx) => (
            <details class="faq-item" open={idx === 0} data-faq-idx={idx}>
              <summary>{item.q}</summary>
              <p class="faq-answer">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Monumental Darkroom Curtain CTA -->
  <section class="p95-curtain">
    <div class="p95-watermark" aria-hidden="true">AIGC STUDIO</div>
    <div class="container p95-curtain-inner" data-reveal>
      <h2>开源免费，安装即用。</h2>
      <p>MIT 协议 · Windows / macOS / Linux · 支持 MCP 接入 Claude 与 Cursor</p>
      <div class="cta-actions" style="justify-content: center;">
        <a href={SITE.releases} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">前往 GitHub Releases</a>
        <a href="/guides/free-gpu-no-comfyui" class="btn btn-lg">免显卡指南</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ models: MODELS, views: WORKSPACE_VIEWS }}>
    (() => {
      // 1. Full-Viewport Slide Projector Hero
      let idx = 1;
      const bg = document.getElementById('p95-bg');
      const numEl = document.getElementById('p95-num');
      const titleEl = document.getElementById('p95-title');
      const metaEl = document.getElementById('p95-meta');
      const licEl = document.getElementById('p95-lic');
      const slideBtns = Array.from(document.querySelectorAll('[data-slide-idx]'));

      function setSlide(next) {
        idx = (next + models.length) % models.length;
        const m = models[idx];
        if (!m || !bg) return;
        bg.classList.add('is-fade');
        setTimeout(() => {
          bg.src = m.showcase.image;
          bg.alt = m.showcase.title;
          bg.style.objectPosition = m.showcase.pos || '50% 50%';
          if (numEl) numEl.textContent = `0${idx + 1}`;
          if (titleEl) titleEl.textContent = m.showcase.title;
          if (metaEl) metaEl.textContent = `${m.label} · ${m.showcase.measuredSec}`;
          if (licEl) licEl.textContent = m.license;
          bg.classList.remove('is-fade');
        }, 180);
        slideBtns.forEach((b, i) => b.classList.toggle('is-active', i === idx));
      }

      slideBtns.forEach((btn) => {
        btn.addEventListener('click', () => setSlide(Number(btn.getAttribute('data-slide-idx'))));
      });

      document.addEventListener('keydown', (e) => {
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLSelectElement) return;
        if (e.key === 'ArrowRight') setSlide(idx + 1);
        if (e.key === 'ArrowLeft') setSlide(idx - 1);
      });

      document.getElementById('p95-zoom-hero')?.addEventListener('click', () => {
        const m = models[idx];
        if (m && window.__openLightbox) {
          window.__openLightbox(m.showcase.image, `${m.showcase.title} — ${m.label}（${m.showcase.measuredSec}）`);
        }
      });

      // 2. Sticky Scroll Narrative (滚动粘性叙事 — 全尺寸窗口均保持粘性联动)
      const storySticky = document.querySelector('.story-sticky');
      const steps = Array.from(document.querySelectorAll('[data-story-step]'));
      const slides = Array.from(document.querySelectorAll('[data-story-slide]'));
      const storyLabel = document.getElementById('story-label');
      const storyCounter = document.getElementById('story-counter');
      const railFill = document.getElementById('story-rail-fill');
      const progFill = document.getElementById('story-progress-fill');
      let currentStory = 0;

      function activateStory(next) {
        if (next === currentStory) return;
        currentStory = next;
        steps.forEach((el, i) => el.classList.toggle('is-active', i === next));
        slides.forEach((el, i) => el.classList.toggle('is-active', i === next));
        const pct = ((next + 1) / steps.length) * 100;
        if (storyLabel && views[next]) storyLabel.textContent = views[next].label;
        if (storyCounter) storyCounter.textContent = `0${next + 1} / 0${steps.length}`;
        if (railFill) railFill.style.height = `${pct}%`;
        if (progFill) progFill.style.width = `${pct}%`;
      }

      let ticking = false;
      function updateStoryOnScroll() {
        ticking = false;
        if (steps.length === 0) return;
        const isStacked = window.innerWidth <= 760;
        const focusY = isStacked && storySticky
          ? storySticky.getBoundingClientRect().bottom + 84
          : window.innerHeight * 0.44;
        let bestIdx = 0;
        let bestDist = Infinity;
        steps.forEach((el, i) => {
          const rect = el.getBoundingClientRect();
          const center = rect.top + rect.height * 0.5;
          const dist = Math.abs(center - focusY);
          if (dist < bestDist) {
            bestDist = dist;
            bestIdx = i;
          }
        });
        activateStory(bestIdx);
      }

      const scheduleStory = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateStoryOnScroll);
        }
      };
      window.addEventListener('scroll', scheduleStory, { passive: true });
      window.addEventListener('resize', scheduleStory, { passive: true });
      updateStoryOnScroll();

      steps.forEach((el, i) => {
        el.addEventListener('click', () => {
          activateStory(i);
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      // 3. FAQ Sticky Live Counter
      const faqNum = document.getElementById('p95-faq-num');
      document.querySelectorAll('[data-faq-idx]').forEach((det) => {
        det.addEventListener('toggle', () => {
          if (det.open && faqNum) {
            const n = Number(det.getAttribute('data-faq-idx')) + 1;
            faqNum.textContent = `0${n} / 07`;
          }
        });
      });
    })();
  </script>
</BaseLayout>
