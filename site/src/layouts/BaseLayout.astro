---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/noto-serif-sc/700.css';
import { DOWNLOAD, SITE, getSiteContent } from '../data/site';
import { SITE_UI, type SiteLang, basePathOf, localePath, normalizeSiteLang } from '../i18n';
import '../styles/global.css';
import '../styles/darkroom.css';
import '../styles/editorial.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  lang?: SiteLang;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const lang = normalizeSiteLang(Astro.props.lang);
const ui = SITE_UI[lang];
const { site, download } = getSiteContent(lang);

const {
  title = site.title,
  description = site.description,
  path = '/',
  ogImage = '/assets/og-cover.png',
  jsonLd,
} = Astro.props;

const logicalPath = basePathOf(path);
const currentLocalePath = localePath(logicalPath, lang);
const zhUrl = new URL(localePath(logicalPath, 'zh'), SITE.domain).toString();
const enUrl = new URL(localePath(logicalPath, 'en'), SITE.domain).toString();
const canonicalUrl = new URL(currentLocalePath, SITE.domain).toString();
const switchHref = localePath(logicalPath, ui.langSwitch.targetLang);
const ogImageUrl = new URL(ogImage, SITE.domain).toString();
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const cfBeaconToken = (import.meta.env.PUBLIC_CF_BEACON_TOKEN || '').trim();
const umamiWebsiteId = (import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '').trim();
const umamiScriptUrl = (import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || 'https://cloud.umami.is/script.js').trim();
---

<!doctype html>
<html lang={ui.htmlLang} data-theme="darkroom">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="T5UoS-VQ8UEQxHc-JsA1AZHGDCGfwwVRJSdEjEGvbkI" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/png" href="/assets/logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline define:vars={{ pageLang: lang, enTargetPath: localePath(logicalPath, 'en') }}>
      try {
        if (pageLang === 'zh') {
          var savedLang = localStorage.getItem('aigc-site-lang');
          var isBot = /bot|crawl|spider|slurp|bingpreview|googlebot|baiduspider|yandex|duckduckbot/i.test(navigator.userAgent || '');
          if (!savedLang && !isBot) {
            var navLang = String((Array.isArray(navigator.languages) && navigator.languages[0]) || navigator.language || '').toLowerCase();
            if (navLang && !navLang.startsWith('zh')) {
              window.location.replace(enTargetPath + window.location.search + window.location.hash);
            }
          }
        }
      } catch {}
      try {
        const saved = localStorage.getItem('aigc-site-theme');
        if (saved === 'daylight' || saved === 'darkroom') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch {}
    </script>

    {schemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />
    )}
    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
    {umamiWebsiteId && (
      <script defer src={umamiScriptUrl} data-website-id={umamiWebsiteId} />
    )}
  </head>
  <body>
    <div class="p95-grain" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container nav-inner">
        <a href={localePath('/', lang)} class="brand" aria-label={ui.brandAria}>
          <img src="/assets/logo.png" alt="" width="22" height="22" />
          <span>AIGC Studio</span>
          <span class="brand-tag">v{SITE.version}</span>
        </a>

        <nav class="nav-links" aria-label={ui.navAria}>
          <a href={localePath('/#domains', lang)}>{ui.nav.domains}</a>
          <a href={localePath('/models', lang)} class={logicalPath === '/models' ? 'is-current' : ''}>{ui.nav.models}</a>
          <a href={localePath('/hardware', lang)} class={logicalPath === '/hardware' ? 'is-current' : ''}>{ui.nav.hardware}</a>
          <a href={localePath('/workshop', lang)} class={logicalPath === '/workshop' ? 'is-current' : ''}>{ui.nav.workshop}</a>
          <a href={localePath('/guides', lang)} class={logicalPath.startsWith('/guides') ? 'is-current' : ''}>{ui.nav.guides}</a>
        </nav>

        <div class="nav-actions">
          <a
            href={switchHref}
            class="btn nav-lang-btn"
            data-lang-switch={ui.langSwitch.targetLang}
            aria-label={ui.langSwitch.aria}
          >{ui.langSwitch.label}</a>
          <button type="button" id="site-theme-btn" class="btn nav-theme-btn" aria-label={ui.theme.aria}>
            <span class="lamp-dot" aria-hidden="true"></span>
            <span id="site-theme-lbl" class="nav-theme-lbl">{ui.theme.toDaylight}</span>
          </button>
          <a href={SITE.github} class="btn btn-ghost nav-gh-btn" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a
            href={DOWNLOAD.winUrl}
            class="btn btn-primary nav-dl-btn"
            data-os-download="compact"
            data-umami-event="download-client"
            data-umami-event-slot="navbar"
            target="_blank"
            rel="noopener noreferrer"
          >{ui.download.compact}</a>
          <button
            type="button"
            id="site-menu-btn"
            class="btn nav-menu-btn"
            aria-label={ui.menuAria}
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
          >
            <span class="nav-menu-bars" aria-hidden="true"><span></span><span></span></span>
          </button>
        </div>
      </div>

      <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
        <div class="container mobile-drawer-inner">
          <nav class="mobile-nav-list" aria-label={ui.mobileNavAria}>
            <a href={localePath('/#domains', lang)}>{ui.nav.domains}</a>
            <a href={localePath('/models', lang)} class={logicalPath === '/models' ? 'is-current' : ''}>{ui.nav.models}</a>
            <a href={localePath('/hardware', lang)} class={logicalPath === '/hardware' ? 'is-current' : ''}>{ui.nav.hardware}</a>
            <a href={localePath('/workshop', lang)} class={logicalPath === '/workshop' ? 'is-current' : ''}>{ui.nav.workshop}</a>
            <a href={localePath('/guides', lang)} class={logicalPath.startsWith('/guides') ? 'is-current' : ''}>{ui.nav.guides}</a>
            <a href={switchHref} data-lang-switch={ui.langSwitch.targetLang}>{ui.langSwitch.aria}</a>
            <a href={SITE.github} target="_blank" rel="noopener noreferrer">{ui.nav.githubSource}</a>
          </nav>
          <div class="mobile-drawer-foot">
            <a
              href={DOWNLOAD.winUrl}
              class="btn btn-primary btn-lg"
              data-os-download="hero"
              data-umami-event="download-client"
              data-umami-event-slot="mobile-drawer"
              target="_blank"
              rel="noopener noreferrer"
            >{ui.download.heroWin.replace('{version}', SITE.version)}</a>
            <p class="mobile-drawer-note" data-os-hint>{download.platformsNote}</p>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="brand">
            <img src="/assets/logo.png" alt="" width="20" height="20" />
            <span>AIGC Studio</span>
          </div>
          <p class="footer-desc">{ui.footer.desc}</p>
          <p class="footer-meta">{ui.footer.meta}</p>
        </div>

        <div class="footer-col">
          <h3>{ui.footer.colProduct}</h3>
          <a href={localePath('/#workflow', lang)}>{ui.footer.workflow}</a>
          <a href={localePath('/models', lang)}>{ui.nav.models}</a>
          <a href={localePath('/hardware', lang)}>{ui.nav.hardware}</a>
          <a href={localePath('/workshop', lang)}>{ui.nav.workshop}</a>
          <a href={localePath('/#compare', lang)}>{ui.footer.compare}</a>
        </div>

        <div class="footer-col">
          <h3>{ui.footer.colGuides}</h3>
          <a href={localePath('/guides', lang)}>{ui.footer.allGuides}</a>
          <a href={localePath('/guides/free-gpu-no-comfyui', lang)}>{ui.footer.guideFreeGpu}</a>
          <a href={localePath('/guides/aigc-studio-vs-comfyui', lang)}>{ui.footer.guideVsComfy}</a>
          <a href={localePath('/guides/mcp-claude-cursor-image', lang)}>{ui.footer.guideMcp}</a>
        </div>

        <div class="footer-col">
          <h3>{ui.footer.colGet}</h3>
          <a
            href={DOWNLOAD.winUrl}
            data-umami-event="download-client"
            data-umami-event-slot="footer"
            target="_blank"
            rel="noopener noreferrer"
          >{ui.footer.downloadWin}</a>
          <a
            href={SITE.github}
            data-umami-event="outbound-github"
            data-umami-event-slot="footer"
            target="_blank"
            rel="noopener noreferrer"
          >{ui.nav.githubSource}</a>
          <a href={ui.footer.llmsHref}>llms.txt</a>
          <a href="/sitemap-index.xml">{ui.footer.sitemap}</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 AIGC Studio · MIT License</span>
        <span>{ui.footer.bottomRight}</span>
      </div>
    </footer>

    <!-- Global Lightbox -->
    <div class="lb-backdrop" id="global-lb" role="dialog" aria-modal="true" aria-label={ui.lightbox.aria}>
      <div class="lb-dialog">
        <img id="global-lb-img" src="" alt="" />
        <div class="lb-bar">
          <span id="global-lb-cap"></span>
          <button type="button" class="lb-close" id="global-lb-close">{ui.lightbox.close}</button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ siteVersion: SITE.version, downloadCfg: download, releasesUrl: SITE.releases, uiTheme: ui.theme, uiDl: ui.download }}>
      (() => {
        // 0. Persist explicit language selection
        document.querySelectorAll('[data-lang-switch]').forEach((el) => {
          el.addEventListener('click', () => {
            const target = el.getAttribute('data-lang-switch');
            if (target === 'zh' || target === 'en') {
              try { localStorage.setItem('aigc-site-lang', target); } catch {}
            }
          });
        });

        // 1. Darkroom / Daylight persistent toggle
        const root = document.documentElement;
        const themeBtn = document.getElementById('site-theme-btn');
        const themeLbl = document.getElementById('site-theme-lbl');
        const syncThemeLabel = () => {
          const isDay = root.getAttribute('data-theme') === 'daylight';
          if (themeLbl) themeLbl.textContent = isDay ? uiTheme.toDarkroom : uiTheme.toDaylight;
        };
        syncThemeLabel();
        themeBtn?.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'daylight' ? 'darkroom' : 'daylight';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('aigc-site-theme', next); } catch {}
          syncThemeLabel();
        });

        // 2. Mobile Navigation Drawer (<= 900px)
        const menuBtn = document.getElementById('site-menu-btn');
        const drawer = document.getElementById('mobile-nav-drawer');
        const setDrawer = (open) => {
          if (!menuBtn || !drawer) return;
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          menuBtn.classList.toggle('is-open', open);
          drawer.hidden = !open;
        };
        menuBtn?.addEventListener('click', () => {
          const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
          setDrawer(!isOpen);
        });
        drawer?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setDrawer(false));
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 900) setDrawer(false);
        });

        // 3. OS-Aware Download Labels (Honest Platform Boundaries)
        const ua = navigator.userAgent || '';
        const plat = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
        const combined = `${plat} ${ua}`.toLowerCase();
        const isMobile = /android|iphone|ipad|ipod|mobile/.test(combined);
        const isWin = !isMobile && /win/.test(combined);
        const isMac = !isMobile && /mac/.test(combined);
        const isLinux = !isMobile && /linux|x11/.test(combined);

        let heroLabel = uiDl.heroWin.replace('{version}', siteVersion);
        let compactLabel = uiDl.compactWin;
        let targetHref = downloadCfg.winUrl || releasesUrl;
        let hintText = uiDl.hintWin.replace('{installer}', downloadCfg.winInstallerName);
        let osTag = 'windows';

        if (isMac) {
          heroLabel = uiDl.heroSource;
          compactLabel = uiDl.compactSource;
          targetHref = downloadCfg.sourceUrl;
          hintText = uiDl.hintMac;
          osTag = 'macos';
        } else if (isLinux) {
          heroLabel = uiDl.heroSource;
          compactLabel = uiDl.compactSource;
          targetHref = downloadCfg.sourceUrl;
          hintText = uiDl.hintLinux;
          osTag = 'linux';
        } else if (isMobile) {
          heroLabel = uiDl.heroMobile.replace('{version}', siteVersion);
          compactLabel = uiDl.compactMobile;
          targetHref = releasesUrl;
          hintText = uiDl.hintMobile;
          osTag = 'mobile';
        } else if (!isWin) {
          heroLabel = uiDl.heroOther.replace('{version}', siteVersion);
          compactLabel = uiDl.compact;
          targetHref = releasesUrl;
          hintText = downloadCfg.platformsNote;
          osTag = 'other';
        }

        const pagePath = window.location.pathname || '/';
        document.querySelectorAll('[data-os-download]').forEach((el) => {
          const mode = el.getAttribute('data-os-download');
          if (el instanceof HTMLAnchorElement) el.href = targetHref;
          el.textContent = mode === 'compact' ? compactLabel : heroLabel;
          el.setAttribute('data-umami-event', 'download-client');
          el.setAttribute('data-umami-event-os', osTag);
          el.setAttribute('data-umami-event-page', pagePath);
        });
        document.querySelectorAll('[data-os-hint]').forEach((el) => {
          el.textContent = hintText;
        });

        // 4. Global Lightbox for any [data-lightbox]
        const lb = document.getElementById('global-lb');
        const lbImg = document.getElementById('global-lb-img');
        const lbCap = document.getElementById('global-lb-cap');
        const closeLb = () => lb?.classList.remove('is-open');
        window.__openLightbox = (src, caption) => {
          if (!lb || !lbImg) return;
          lbImg.src = src;
          lbImg.alt = caption || '';
          if (lbCap) lbCap.textContent = caption || '';
          lb.classList.add('is-open');
        };
        document.addEventListener('click', (e) => {
          const trigger = e.target instanceof Element ? e.target.closest('[data-lightbox]') : null;
          if (!trigger) return;
          const img = trigger.tagName === 'IMG' ? trigger : trigger.querySelector('img');
          if (!img) return;
          window.__openLightbox(img.currentSrc || img.src, trigger.getAttribute('data-caption') || img.alt);
        });
        document.getElementById('global-lb-close')?.addEventListener('click', closeLb);
        lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeLb();
            setDrawer(false);
          }
        });

        // 3. Subtle light-table pointer glow
        document.querySelectorAll('.lighttable').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const rect = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - rect.left}px`);
            el.style.setProperty('--my', `${e.clientY - rect.top}px`);
          });
        });

        // 4. Reveal on scroll
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -24px 0px' },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
