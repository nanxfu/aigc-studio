---
import { SITE } from '../data/site';
import '../styles/global.css';
import '../styles/darkroom.css';
import '../styles/editorial.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.title,
  description = SITE.description,
  path = '/',
  ogImage = '/assets/studio-light.png',
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(path, SITE.domain).toString();
const ogImageUrl = new URL(ogImage, SITE.domain).toString();
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN" data-theme="darkroom">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Noto+Serif+SC:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      try {
        const saved = localStorage.getItem('aigc-site-theme');
        if (saved === 'daylight' || saved === 'darkroom') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch {}
    </script>

    {schemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />
    )}
  </head>
  <body>
    <div class="p95-grain" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label="AIGC Studio 首页">
          <img src="/assets/logo.png" alt="" width="22" height="22" />
          <span>AIGC Studio</span>
          <span class="brand-tag">v{SITE.version}</span>
        </a>

        <nav class="nav-links" aria-label="主导航">
          <a href="/#domains">垂直领域</a>
          <a href="/models" class={path === '/models' ? 'is-current' : ''}>模型实测</a>
          <a href="/workshop" class={path === '/workshop' ? 'is-current' : ''}>资产工坊</a>
          <a href="/guides/free-gpu-no-comfyui" class={path.startsWith('/guides') ? 'is-current' : ''}>免显卡指南</a>
        </nav>

        <div class="nav-actions">
          <button type="button" id="site-theme-btn" class="btn" aria-label="切换暗房或日光主题">
            <span class="lamp-dot" aria-hidden="true"></span>
            <span id="site-theme-lbl">日光模式</span>
          </button>
          <a href={SITE.github} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE.releases} class="btn btn-primary" target="_blank" rel="noopener noreferrer">下载客户端</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="brand">
            <img src="/assets/logo.png" alt="" width="20" height="20" />
            <span>AIGC Studio</span>
          </div>
          <p class="footer-desc">
            独立的开源桌面生图工作台。界面与文件留在本地，算力按需挂载云端。
          </p>
          <p class="footer-meta">MIT 开源 · Windows / macOS / Linux</p>
        </div>

        <div class="footer-col">
          <h3>PRODUCT</h3>
          <a href="/#workflow">工作原理</a>
          <a href="/models">模型实测</a>
          <a href="/workshop">资产工坊</a>
          <a href="/#compare">方案对比</a>
        </div>

        <div class="footer-col">
          <h3>DOCS</h3>
          <a href="/guides/free-gpu-no-comfyui">免显卡上手指南</a>
          <a href="/#faq">常见问答</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="/sitemap-index.xml">站点地图</a>
        </div>

        <div class="footer-col">
          <h3>GET</h3>
          <a href={SITE.releases} target="_blank" rel="noopener noreferrer">下载安装包</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub 源码</a>
          <a href={`${SITE.github}/issues`} target="_blank" rel="noopener noreferrer">问题反馈</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 AIGC Studio · MIT License</span>
        <span>本地优先 · 无云端账号绑定</span>
      </div>
    </footer>

    <!-- Global Lightbox -->
    <div class="lb-backdrop" id="global-lb" role="dialog" aria-modal="true" aria-label="大图检视">
      <div class="lb-dialog">
        <img id="global-lb-img" src="" alt="" />
        <div class="lb-bar">
          <span id="global-lb-cap"></span>
          <button type="button" class="lb-close" id="global-lb-close">ESC 关闭</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        // 1. Darkroom / Daylight persistent toggle
        const root = document.documentElement;
        const themeBtn = document.getElementById('site-theme-btn');
        const themeLbl = document.getElementById('site-theme-lbl');
        const syncThemeLabel = () => {
          const isDay = root.getAttribute('data-theme') === 'daylight';
          if (themeLbl) themeLbl.textContent = isDay ? '暗房模式' : '日光模式';
        };
        syncThemeLabel();
        themeBtn?.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'daylight' ? 'darkroom' : 'daylight';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('aigc-site-theme', next); } catch {}
          syncThemeLabel();
        });

        // 2. Global Lightbox for any [data-lightbox]
        const lb = document.getElementById('global-lb');
        const lbImg = document.getElementById('global-lb-img');
        const lbCap = document.getElementById('global-lb-cap');
        const closeLb = () => lb?.classList.remove('is-open');
        window.__openLightbox = (src, caption) => {
          if (!lb || !lbImg) return;
          lbImg.src = src;
          lbImg.alt = caption || '';
          if (lbCap) lbCap.textContent = caption || '';
          lb.classList.add('is-open');
        };
        document.addEventListener('click', (e) => {
          const trigger = e.target instanceof Element ? e.target.closest('[data-lightbox]') : null;
          if (!trigger) return;
          const img = trigger.tagName === 'IMG' ? trigger : trigger.querySelector('img');
          if (!img) return;
          window.__openLightbox(img.currentSrc || img.src, trigger.getAttribute('data-caption') || img.alt);
        });
        document.getElementById('global-lb-close')?.addEventListener('click', closeLb);
        lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });

        // 3. Subtle light-table pointer glow
        document.querySelectorAll('.lighttable').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const rect = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - rect.left}px`);
            el.style.setProperty('--my', `${e.clientY - rect.top}px`);
          });
        });

        // 4. Reveal on scroll
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -24px 0px' },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
