---
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.title,
  description = SITE.description,
  path = '/',
  ogImage = '/assets/studio-light.png',
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(path, SITE.domain).toString();
const ogImageUrl = new URL(ogImage, SITE.domain).toString();
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label="AIGC Studio 首页">
          <img src="/assets/logo.png" alt="" width="24" height="24" />
          <span class="brand-name">AIGC Studio</span>
          <span class="brand-tag">v{SITE.version}</span>
        </a>

        <nav class="nav-links" aria-label="主导航">
          <a href="/#workflow">工作原理</a>
          <a href="/models">7 款模型</a>
          <a href="/workshop">资产工坊</a>
          <a href="/guides/free-gpu-no-comfyui">免显卡指南</a>
          <a href="/#faq">常见问答</a>
        </nav>

        <div class="nav-actions">
          <a href={SITE.github} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE.releases} class="btn btn-primary" target="_blank" rel="noopener noreferrer">下载客户端</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="brand">
            <img src="/assets/logo.png" alt="" width="22" height="22" />
            <span class="brand-name">AIGC Studio</span>
          </div>
          <p class="footer-desc">
            独立的开源桌面端 AI 生图工作台。界面与作品留在本地，GPU 推理按需挂载云端。
          </p>
          <p class="footer-meta">MIT 协议开源 · Windows / macOS / Linux</p>
        </div>

        <div class="footer-col">
          <h3>产品</h3>
          <a href="/#workflow">三步出图</a>
          <a href="/models">内置模型实测</a>
          <a href="/workshop">资产工坊</a>
          <a href="/#compare">方案对比</a>
        </div>

        <div class="footer-col">
          <h3>文档与指南</h3>
          <a href="/guides/free-gpu-no-comfyui">无显卡运行 FLUX.2 指南</a>
          <a href="/#faq">常见问题</a>
          <a href="/llms.txt">llms.txt（AI 索引）</a>
          <a href="/sitemap-index.xml">站点地图</a>
        </div>

        <div class="footer-col">
          <h3>获取</h3>
          <a href={SITE.releases} target="_blank" rel="noopener noreferrer">下载安装包</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub 源码</a>
          <a href={`${SITE.github}/issues`} target="_blank" rel="noopener noreferrer">问题反馈</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 AIGC Studio · MIT License</span>
        <span>本地优先 · 不绑定云端账号</span>
      </div>
    </footer>

    <script is:inline>
      // 轻克制滚动显隐
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -32px 0px' },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
