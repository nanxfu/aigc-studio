---
import { DOWNLOAD, SITE, getSiteContent } from '../data/site';
import { type SiteLang, localePath, normalizeSiteLang } from '../i18n';

interface Props {
  currentSlug: string;
  lang?: SiteLang;
}
const lang = normalizeSiteLang(Astro.props.lang);
const isEn = lang === 'en';
const { currentSlug } = Astro.props;
const { guides } = getSiteContent(lang);
const others = guides.filter((g) => g.slug !== currentSlug).slice(0, 4);
---

<section class="section" aria-label={isEn ? 'Related guides' : '相关指南'} style="padding: 64px 0;">
  <div class="container">
    <div class="guide-related-head">
      <h2>RELATED GUIDES</h2>
      <a href={localePath('/guides', lang)} class="link-inline" style="font-size: 13px;">{isEn ? 'All Guides →' : '全部指南 →'}</a>
    </div>
    <div class="guide-grid">
      {others.map((g) => (
        <a href={g.path} class="guide-card">
          <div class="guide-card-top">
            <span>{g.tag}</span>
            <span>{g.readTime}</span>
          </div>
          <h3>{g.title}</h3>
          <p>{g.description}</p>
          <div class="guide-card-foot">
            <span>{g.audience}</span>
            <span>{isEn ? 'Read →' : '阅读 →'}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="p95-curtain">
  <div class="p95-watermark" aria-hidden="true">AIGC STUDIO</div>
  <div class="container p95-curtain-inner">
    <h2>{isEn ? 'Open source. Free to use.' : '开源软件，免费使用。'}</h2>
    <p>{isEn ? 'MIT License · Windows x64 installer (macOS / Linux supported via source)' : 'MIT 协议 · Windows x64 安装包（macOS / Linux 支持源码运行）'}</p>
    <div class="cta-actions" style="justify-content: center;">
      <a href={DOWNLOAD.winUrl} class="btn btn-primary btn-lg" data-os-download="hero" data-umami-event-slot="guide-related" target="_blank" rel="noopener noreferrer">
        {isEn ? `Download Windows v${SITE.version}` : `下载 Windows 版 v${SITE.version}`}
      </a>
      <a href={localePath('/models', lang)} class="btn btn-lg">{isEn ? 'Model Benchmarks' : '模型实测'}</a>
    </div>
  </div>
</section>
