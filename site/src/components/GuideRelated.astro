---
import { DOWNLOAD, GUIDES, SITE } from '../data/site';

interface Props {
  currentSlug: string;
}
const { currentSlug } = Astro.props;
const others = GUIDES.filter((g) => g.slug !== currentSlug).slice(0, 4);
---

<section class="section" aria-label="延伸阅读" style="padding: 64px 0;">
  <div class="container">
    <div class="guide-related-head">
      <h2>RELATED GUIDES</h2>
      <a href="/guides" class="link-inline" style="font-size: 13px;">全部指南 →</a>
    </div>
    <div class="guide-grid">
      {others.map((g) => (
        <a href={g.path} class="guide-card">
          <div class="guide-card-top">
            <span>{g.tag}</span>
            <span>{g.readTime}</span>
          </div>
          <h3>{g.title}</h3>
          <p>{g.description}</p>
          <div class="guide-card-foot">
            <span>{g.audience}</span>
            <span>阅读 →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="p95-curtain">
  <div class="p95-watermark" aria-hidden="true">AIGC STUDIO</div>
  <div class="container p95-curtain-inner">
    <h2>开源免费，安装即用。</h2>
    <p>MIT 协议 · Windows x64 安装包（macOS / Linux 支持源码运行）</p>
    <div class="cta-actions" style="justify-content: center;">
      <a href={DOWNLOAD.winUrl} class="btn btn-primary btn-lg" data-os-download="hero" target="_blank" rel="noopener noreferrer">
        下载 Windows 版 v{SITE.version}
      </a>
      <a href="/models" class="btn btn-lg">模型实测</a>
    </div>
  </div>
</section>
