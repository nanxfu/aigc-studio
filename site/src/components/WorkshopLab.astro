---
import { WORKSHOP_TOOLS } from '../data/site';

interface Props {
  showLink?: boolean;
  hideHeader?: boolean;
}
const { showLink = true, hideHeader = false } = Astro.props;

const labConfigs = [
  {
    id: 'cutout',
    beforeLabel: '原图（SDXL 实拍）',
    label: 'BiRefNet 透明底 PNG',
    before: '/assets/workshop/shield-source.webp',
    after: '/assets/workshop/shield-cutout.webp',
    mode: 'cutout',
    contain: true,
    beforePixel: false,
    afterPixel: false,
    note: '真机 BiRefNet 实测输出（47.08% 全透明像素），提取前景主体并保留边缘细节。',
  },
  {
    id: 'vectorize',
    beforeLabel: '32px 位图放大',
    label: 'VTracer 实算 SVG',
    before: '/assets/workshop/vector-before.webp',
    after: '/assets/workshop/vector-after.svg',
    mode: 'svg',
    contain: true,
    beforePixel: true,
    afterPixel: false,
    note: '本机 WASM 版 VTracer 离线实算，把低分辨率位图直接转为平滑可缩放的矢量路径。',
  },
  {
    id: 'tile',
    beforeLabel: '直接 2×2 平铺（有接缝）',
    label: '余弦混边 2×2 无缝贴图',
    before: '/assets/workshop/tile-before.webp',
    after: '/assets/workshop/tile-after.webp',
    mode: 'tile',
    contain: false,
    beforePixel: false,
    afterPixel: false,
    note: '同一块盾牌纹理实算 blendSeamEdges 混边，拉动滑块可对比中心十字接缝的消除效果。',
  },
  {
    id: 'pixel-snap',
    beforeLabel: '模糊虚边原图',
    label: '网格对齐 + Oklab 色板',
    before: '/assets/workshop/pixel-before.webp',
    after: '/assets/workshop/pixel-after.webp',
    mode: 'pixel',
    contain: true,
    beforePixel: false,
    afterPixel: true,
    note: '本机 snapPixelArt 实算结果：探测像素格距、重采样对齐并压缩杂色与半透明虚边。',
  },
  {
    id: 'sprite-slice',
    beforeLabel: '2×2 序列帧图集',
    label: '逐帧回放 · atlas.json',
    before: '/assets/workshop/sprite-sheet.webp',
    after: '/assets/workshop/sprite-0.webp',
    frames: [
      '/assets/workshop/sprite-0.webp',
      '/assets/workshop/sprite-1.webp',
      '/assets/workshop/sprite-2.webp',
      '/assets/workshop/sprite-3.webp',
    ],
    mode: 'sprite',
    contain: true,
    beforePixel: true,
    afterPixel: true,
    note: '本机 sliceSpriteFrames 实算切分 4 帧，现场回放动画并随 atlas.json 整包导出。',
  },
  {
    id: 'pbr',
    beforeLabel: '原图（SDXL 实拍）',
    label: 'Marigold · Normal',
    before: '/assets/workshop/shield-source.webp',
    after: '/assets/workshop/shield-normal.webp',
    pbrMaps: {
      normal: '/assets/workshop/shield-normal.webp',
      rough: '/assets/workshop/shield-roughness.webp',
      metal: '/assets/workshop/shield-metallic.webp',
      albedo: '/assets/workshop/shield-albedo.webp',
    },
    mode: 'pbr',
    contain: true,
    beforePixel: false,
    afterPixel: false,
    note: '真机 Marigold 内在分解 4 步实测，拆出 Albedo、Normal、Roughness 与 Metallic 四张真实贴图。',
  },
];
---

<section class="section" id="workshop" style={hideHeader ? 'padding-top: 32px; border-top: 0;' : ''}>
  <div class="container">
    {!hideHeader && (
      <div class="section-head" data-reveal>
        <div>
          <div class="section-idx">04 / ASSET WORKSHOP</div>
          <h2 class="section-title">资产工坊</h2>
        </div>
        <p class="section-sub">
          以下 6 组对照均为本机算子与云端 GPU 实跑产出：转 SVG、无缝平铺、像素对齐与序列帧于本机离线直算，抹除背景与 PBR 拆解由云端队列处理。
          {showLink && <a href="/workshop" class="link-inline">查看详情 →</a>}
        </p>
      </div>
    )}

    <div class="ws-grid" data-reveal>
      <div>
        <div class="split-stage" id="ws-stage">
          <div class="split-layer ws-stage-contain" id="ws-before-layer">
            <img id="ws-before" src={labConfigs[0].before} alt="工坊处理前原图" />
            <div class="ws-tile-grid" id="ws-before-tile" style="display:none;">
              <img src={labConfigs[2].before} alt="" />
              <img src={labConfigs[2].before} alt="" />
              <img src={labConfigs[2].before} alt="" />
              <img src={labConfigs[2].before} alt="" />
            </div>
          </div>

          <div class="split-layer split-after ws-checker ws-stage-contain" id="ws-after">
            <img id="ws-after-img" src={labConfigs[0].after} alt="工坊实机处理结果" />
            <div class="ws-tile-grid" id="ws-tile-grid" style="display:none;">
              <img src={labConfigs[2].after} alt="" />
              <img src={labConfigs[2].after} alt="" />
              <img src={labConfigs[2].after} alt="" />
              <img src={labConfigs[2].after} alt="" />
            </div>
            <div class="ws-pixel-overlay" aria-hidden="true"></div>
          </div>

          <div class="split-divider" id="ws-divider"></div>
          <span class="split-tag l" id="ws-tag-l">{labConfigs[0].beforeLabel}</span>
          <span class="split-tag r" id="ws-tag-r">{labConfigs[0].label}</span>
          <input class="split-range" id="ws-range" type="range" min="4" max="96" value="50" aria-label="拖动对比工坊处理前后" />
        </div>

        <div class="ws-subbar">
          <span id="ws-note">{labConfigs[0].note}</span>
          <div class="ws-ch-group" id="ws-pbr-channels" role="tablist" aria-label="PBR 通道切换">
            <button type="button" class="ws-ch-btn is-active" data-pbr-ch="normal">Normal</button>
            <button type="button" class="ws-ch-btn" data-pbr-ch="rough">Roughness</button>
            <button type="button" class="ws-ch-btn" data-pbr-ch="metal">Metallic</button>
            <button type="button" class="ws-ch-btn" data-pbr-ch="albedo">Albedo</button>
          </div>
        </div>
      </div>

      <div class="ws-list" role="tablist" aria-label="工坊工具列表">
        {WORKSHOP_TOOLS.map((t, i) => (
          <button type="button" class={i === 0 ? 'ws-row is-active' : 'ws-row'} data-ws-idx={i}>
            <div>
              <h3>{t.name}</h3>
              <p>{t.engine} · 输出 {t.output}</p>
            </div>
            <span class={t.local ? 'badge badge-ok' : 'badge'}>{t.runtime}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ labConfigs }}>
  (() => {
    const range = document.getElementById('ws-range');
    const beforeLayer = document.getElementById('ws-before-layer');
    const after = document.getElementById('ws-after');
    const divider = document.getElementById('ws-divider');
    const beforeImg = document.getElementById('ws-before');
    const afterImg = document.getElementById('ws-after-img');
    const beforeTile = document.getElementById('ws-before-tile');
    const tileGrid = document.getElementById('ws-tile-grid');
    const tagL = document.getElementById('ws-tag-l');
    const tagR = document.getElementById('ws-tag-r');
    const noteEl = document.getElementById('ws-note');
    const pbrBar = document.getElementById('ws-pbr-channels');
    const pbrBtns = Array.from(document.querySelectorAll('[data-pbr-ch]'));
    const toolBtns = Array.from(document.querySelectorAll('[data-ws-idx]'));

    const pbrNames = { normal: 'Normal', rough: 'Roughness', metal: 'Metallic', albedo: 'Albedo' };
    let currentCfg = labConfigs[0];
    let currentPbr = 'normal';
    let spriteTimer = null;
    let spriteFrame = 0;

    function stopSprite() {
      if (spriteTimer) {
        clearInterval(spriteTimer);
        spriteTimer = null;
      }
    }

    range?.addEventListener('input', (e) => {
      const v = e.target.value;
      if (after) after.style.clipPath = `inset(0 0 0 ${v}%)`;
      if (divider) divider.style.left = `${v}%`;
    });

    function applyPbr(ch) {
      currentPbr = ch;
      const pbrCfg = labConfigs.find((c) => c.mode === 'pbr');
      if (afterImg && pbrCfg && pbrCfg.pbrMaps && pbrCfg.pbrMaps[ch]) {
        afterImg.src = pbrCfg.pbrMaps[ch];
      }
      if (tagR) tagR.textContent = `Marigold · ${pbrNames[ch] || ch}`;
      pbrBtns.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-pbr-ch') === ch));
    }

    pbrBtns.forEach((btn) => {
      btn.addEventListener('click', () => applyPbr(btn.getAttribute('data-pbr-ch') || 'normal'));
    });

    function selectTool(idx) {
      stopSprite();
      const cfg = labConfigs[idx] || labConfigs[0];
      currentCfg = cfg;
      const isTile = cfg.mode === 'tile';

      if (beforeImg) {
        beforeImg.src = cfg.before;
        beforeImg.style.display = isTile ? 'none' : 'block';
      }
      if (beforeTile) beforeTile.style.display = isTile ? 'grid' : 'none';
      if (afterImg) {
        afterImg.src = cfg.mode === 'pbr' && cfg.pbrMaps ? cfg.pbrMaps[currentPbr] : cfg.after;
        afterImg.style.display = isTile ? 'none' : 'block';
      }
      if (tileGrid) tileGrid.style.display = isTile ? 'grid' : 'none';
      if (tagL) tagL.textContent = cfg.beforeLabel;
      if (tagR) tagR.textContent = cfg.label;
      if (noteEl) noteEl.textContent = cfg.note;

      if (beforeLayer) {
        beforeLayer.className = 'split-layer';
        if (cfg.contain) beforeLayer.classList.add('ws-stage-contain');
        if (cfg.beforePixel) beforeLayer.classList.add('ws-stage-pixel');
      }
      if (after) {
        after.className = 'split-layer split-after';
        if (cfg.mode === 'cutout' || cfg.mode === 'sprite' || cfg.mode === 'svg' || cfg.mode === 'pixel') {
          after.classList.add('ws-checker');
        }
        if (cfg.contain) after.classList.add('ws-stage-contain');
        if (cfg.afterPixel) after.classList.add('ws-stage-pixel');
        if (cfg.mode === 'pixel') after.classList.add('ws-mode-pixel');
      }

      pbrBar?.classList.toggle('is-show', cfg.mode === 'pbr');
      if (cfg.mode === 'pbr') applyPbr(currentPbr);

      if (cfg.mode === 'sprite' && Array.isArray(cfg.frames) && cfg.frames.length > 1) {
        spriteFrame = 0;
        spriteTimer = setInterval(() => {
          if (currentCfg.mode !== 'sprite' || !afterImg) return;
          spriteFrame = (spriteFrame + 1) % cfg.frames.length;
          afterImg.src = cfg.frames[spriteFrame];
        }, 260);
      }

      toolBtns.forEach((b, i) => b.classList.toggle('is-active', i === idx));
    }

    toolBtns.forEach((btn) => {
      btn.addEventListener('click', () => selectTool(Number(btn.getAttribute('data-ws-idx'))));
    });
  })();
</script>
