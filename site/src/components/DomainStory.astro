---
import { type SiteLang, normalizeSiteLang } from '../i18n';
import '../styles/domain-story.css';

interface Props {
  lang?: SiteLang;
}
const lang = normalizeSiteLang(Astro.props.lang);
const isEn = lang === 'en';

const domains = isEn
  ? [
      {
        idx: '01',
        en: 'GAME CONCEPT',
        nav: 'Game Concepts',
        title: 'Game Worlds & Character Art',
        desc: 'From brutalist spaceports to cel-shaded character portraits. Send outputs straight to the Workshop for background cutout, pixel grid snapping, and sprite sheet slicing.',
        tags: ['Environment Art', 'Character Sheets', 'Pixel Snap', 'Sprite Atlas'],
        heroImg: '/assets/domains/game-scifi.webp',
        heroPos: '50% 45%',
        insetImg: '/assets/domains/game-anime.webp',
        insetTitle: 'Neon Rain Courier',
        insetMeta: 'Anima Turbo v1.1',
      },
      {
        idx: '02',
        en: '3D & MATERIAL',
        nav: '3D & Materials',
        title: 'Dioramas & PBR Texture Maps',
        desc: 'Generate isometric cutaways, optical glass studies, and surface textures—then tile them seamlessly or decompose 4-channel PBR maps ready for your engine.',
        tags: ['Isometric 3D', 'Seamless Tile', '4-Channel PBR', 'Unity / Godot'],
        heroImg: '/assets/domains/3d-diorama.webp',
        heroPos: '50% 50%',
        insetImg: '/assets/domains/3d-crystal.webp',
        insetTitle: 'Emerald Crystal Study',
        insetMeta: 'FLUX.2 Klein 9B',
      },
      {
        idx: '03',
        en: 'GRAPHIC DESIGN',
        nav: 'Graphic & Poster',
        title: 'Editorial Posters & Typography',
        desc: 'Render crisp headlines, balanced margins, and paper grain in a single pass—or vectorize flat graphics and badges into editable SVG paths locally.',
        tags: ['Clean Typography', 'Poster Layout', 'SVG Vector', 'Alpha PNG'],
        heroImg: '/assets/showcase/qwen-image-2.1-botanica-poster.webp',
        heroPos: '50% 24%',
        insetImg: '/assets/domains/graphic-poster.webp',
        insetTitle: 'BREW 2026 Poster',
        insetMeta: 'Qwen-Image 2.1',
      },
      {
        idx: '04',
        en: 'PHOTOGRAPHY',
        nav: 'Still Life & Portrait',
        title: 'Product Still Life & Portraits',
        desc: 'True-to-life brushed metal, glass reflections, and film portrait lighting. Inpaint, iterate from references, and upscale inside one local version tree.',
        tags: ['Material Fidelity', 'Inpainting', 'Reference Control', 'Local History'],
        heroImg: '/assets/showcase/flux2-klein-9b-clockmaker-bench.webp',
        heroPos: '50% 50%',
        insetImg: '/assets/domains/photo-portrait.webp',
        insetTitle: 'Misty Dock Fisherman',
        insetMeta: 'Z-Image Turbo',
      },
    ]
  : [
      {
        idx: '01',
        en: 'GAME CONCEPT',
        nav: '游戏概念',
        title: '游戏场景与角色设定',
        desc: '从太空港场景到二次元角色立绘，生成后可继续去背、像素对齐和序列帧切片。',
        tags: ['场景概念图', '角色立绘', '像素对齐', '序列帧图集'],
        heroImg: '/assets/domains/game-scifi.webp',
        heroPos: '50% 45%',
        insetImg: '/assets/domains/game-anime.webp',
        insetTitle: '霓虹雨夜信使',
        insetMeta: 'Anima Turbo v1.1',
      },
      {
        idx: '02',
        en: '3D & MATERIAL',
        nav: '3D 与建模',
        title: '微缩建模与 PBR 贴图',
        desc: '先生成等距 3D 参考图和表面纹理，再用工坊处理平铺和 PBR 贴图，结果可导入 Unity 或 Godot。',
        tags: ['等距 3D 场景', '无缝平铺', 'PBR 四通道', 'Unity / Godot'],
        heroImg: '/assets/domains/3d-diorama.webp',
        heroPos: '50% 50%',
        insetImg: '/assets/domains/3d-crystal.webp',
        insetTitle: '翡翠折射静物',
        insetMeta: 'FLUX.2 Klein 9B',
      },
      {
        idx: '03',
        en: 'GRAPHIC DESIGN',
        nav: '平面与海报',
        title: '品牌海报与字形排版',
        desc: '生成带中英文标题、网格留白和纸面肌理的海报；扁平图形与标识可在本机转成可编辑 SVG。',
        tags: ['中英文出字', '海报版式', 'SVG 矢量', '透明底 PNG'],
        heroImg: '/assets/showcase/qwen-image-2.1-botanica-poster.webp',
        heroPos: '50% 24%',
        insetImg: '/assets/domains/graphic-poster.webp',
        insetTitle: 'BREW 2026 展陈海报',
        insetMeta: 'Qwen-Image 2.1',
      },
      {
        idx: '04',
        en: 'PHOTOGRAPHY',
        nav: '静物与人像',
        title: '商业静物与写实人像',
        desc: '适合金属、玻璃和自然肤质等细节；重绘、参考图和放大结果会归入版本树并保存在本地。',
        tags: ['材质还原', '局部重绘', '参考图控制', '本地原图归档'],
        heroImg: '/assets/showcase/flux2-klein-9b-clockmaker-bench.webp',
        heroPos: '50% 50%',
        insetImg: '/assets/domains/photo-portrait.webp',
        insetTitle: '雾晨码头渔夫',
        insetMeta: 'Z-Image Turbo',
      },
    ];
---

<section class="domain-track" id="domains" aria-label={isEn ? 'Vertical domains showcase' : '垂直领域实测展陈'}>
  <div class="domain-sticky">
    <!-- Top 4-Segment Scroll HUD -->
    <div class="domain-hud">
      <div class="container">
        <div class="domain-hud-bar">
          {domains.map((d, i) => (
            <button type="button" class={i === 0 ? 'domain-nav-item is-active' : 'domain-nav-item'} data-domain-jump={i} aria-current={i === 0 ? 'step' : undefined}>
              <div class="domain-nav-line">
                <div class="domain-nav-fill" data-domain-fill={i} style={`transform:scaleX(${i === 0 ? 1 : 0})`}></div>
              </div>
              <div class="domain-nav-label">
                <span><span class="domain-nav-index">{d.idx} / </span>{d.nav}</span>
                <span class="domain-nav-en">{d.en}</span>
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- 4 Full-Bleed Scroll-Driven Curtain Scenes -->
    {domains.map((d, i) => (
      <article class="domain-scene" data-scene={i}>
        <img class="domain-bg" src={d.heroImg} alt={d.title} style={`object-position:${d.heroPos};`} loading="lazy" />
        <div class="domain-scrim" aria-hidden="true"></div>
        <div class="domain-ghost" data-ghost={i} aria-hidden="true">{d.en}</div>

        <div class="container domain-content">
          <div>
            <div class="domain-num">{d.idx}</div>
            <h2 class="domain-title">{d.title}</h2>
            <p class="domain-desc">{d.desc}</p>
            <div class="domain-tags">
              {d.tags.map((tag) => (
                <span class="domain-tag">{tag}</span>
              ))}
            </div>
          </div>

          <div class="domain-inset-wrap" data-inset={i}>
            <figure class="domain-inset" style="margin:0;" data-lightbox data-caption={`${d.insetTitle} — ${d.insetMeta}`}>
              <img src={d.insetImg} alt={d.insetTitle} loading="lazy" />
              <figcaption class="domain-inset-cap">
                <strong>{d.insetTitle}</strong>
                <span>{d.insetMeta}</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    const track = document.getElementById('domains');
    if (!track) return;
    const stage = track.querySelector('.domain-sticky');
    if (!stage) return;
    const scenes = Array.from(track.querySelectorAll('[data-scene]'));
    const bgs = scenes.map((s) => s.querySelector('.domain-bg'));
    const ghosts = scenes.map((s) => s.querySelector('[data-ghost]'));
    const insets = scenes.map((s) => s.querySelector('[data-inset]'));
    const navItems = Array.from(track.querySelectorAll('[data-domain-jump]'));
    const fills = Array.from(track.querySelectorAll('[data-domain-fill]'));
    const count = scenes.length;
    const transitions = count - 1;
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
    let rafId = 0;

    function syncMotionMode() {
      track.classList.toggle('is-animated', !reducedMotionQuery.matches);
      if (!reducedMotionQuery.matches) return;
      scenes.forEach((scene) => { scene.style.clipPath = ''; });
      bgs.forEach((bg) => {
        if (!bg) return;
        bg.style.transform = '';
        bg.style.filter = '';
      });
      ghosts.forEach((ghost) => { if (ghost) ghost.style.transform = ''; });
      insets.forEach((inset) => { if (inset) inset.style.transform = ''; });
    }

    function scrollMetrics() {
      // Match the actual sticky stage, including mobile's stable viewport height.
      return {
        top: track.getBoundingClientRect().top + window.scrollY + track.clientTop,
        travel: Math.max(1, track.clientHeight - stage.offsetHeight),
      };
    }

    function render() {
      rafId = 0;
      if (reducedMotionQuery.matches) return;

      const { top, travel } = scrollMetrics();
      const progress = clamp((window.scrollY - top) / travel, 0, 1);
      const seg = progress * transitions; // 0 .. 3

      // Scene 0 stays at base; Scenes 1..3 wipe upward via clip-path
      for (let i = 1; i < count; i++) {
        const t = clamp(seg - (i - 1), 0, 1);
        scenes[i].style.clipPath = `inset(${((1 - t) * 100).toFixed(2)}% 0 0 0)`;
      }

      // Subtle depth recession on outgoing scenes + ghost drift + inset parallax
      for (let i = 0; i < count; i++) {
        const outgoing = i < count - 1 ? clamp(seg - i, 0, 1) : 0;
        const incoming = i > 0 ? clamp(seg - (i - 1), 0, 1) : 1;
        const bg = bgs[i];
        if (bg) {
          const scale = 1.05 - outgoing * 0.08 + (1 - incoming) * 0.04;
          const bright = 0.56 - outgoing * 0.2;
          bg.style.transform = `scale(${scale.toFixed(4)})`;
          bg.style.filter = `brightness(${bright.toFixed(3)}) contrast(1.06)`;
        }
        const ghost = ghosts[i];
        if (ghost) {
          const drift = (incoming - outgoing - 0.5) * -70;
          ghost.style.transform = `translate(calc(-50% + ${drift.toFixed(1)}px), -50%)`;
        }
        const inset = insets[i];
        if (inset) {
          const lift = (1 - incoming) * 44 - outgoing * 36;
          inset.style.transform = `translateY(${lift.toFixed(1)}px)`;
        }
      }

      // Update Top 4-Segment HUD
      const activeIdx = Math.min(count - 1, Math.round(seg));
      navItems.forEach((item, i) => {
        item.classList.toggle('is-active', i === activeIdx);
        if (i === activeIdx) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
      });
      fills.forEach((fill, i) => {
        let pct = 0;
        if (i === 0) pct = 100;
        else pct = clamp(seg - (i - 1), 0, 1) * 100;
        fill.style.transform = `scaleX(${(pct / 100).toFixed(4)})`;
      });
    }

    function onScroll() {
      if (!rafId) rafId = requestAnimationFrame(render);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('load', onScroll, { once: true });
    reducedMotionQuery.addEventListener?.('change', () => {
      syncMotionMode();
      onScroll();
    });
    syncMotionMode();
    render();

    navItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-domain-jump'));
        const { top, travel } = scrollMetrics();
        window.scrollTo({ top: top + (idx / transitions) * travel, behavior: reducedMotionQuery.matches ? 'instant' : 'smooth' });
      });
    });
  })();
</script>
