[Unit]
Description=AIGC Studio private GPU worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 独立系统用户；不要把 worker 跑成 root。
User=aigc
Group=aigc
WorkingDirectory=/opt/aigc-studio
# 只监听回环：公网访问走 SSH 隧道或 Caddy/Nginx 反代 + TLS。
ExecStart=/opt/aigc-studio/.venv/bin/python /opt/aigc-studio/worker/worker_server.py \
    --host 127.0.0.1 --port 8765 \
    --token-file /etc/aigc/worker-token \
    --no-install
# 长驻服务不要开 --allow-shutdown：Host 的「断开」只应释放连接。
Restart=on-failure
RestartSec=5
# Token 文件由管理员预置：install -m 600 /dev/null /etc/aigc/worker-token
# 模型缓存放独立磁盘时用 Environment 指定 HF_HOME。
Environment=HF_HOME=/var/lib/aigc/hf
Environment=AIGC_WORKER_ARTIFACT_DIR=/var/lib/aigc/artifacts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aigc
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
